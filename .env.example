# Used now: Neon pooled PostgreSQL connection string. Leave empty for the safe unconfigured scaffold.
DATABASE_URL=

# Used now: random secret of at least 32 characters. Never commit a real value.
BETTER_AUTH_SECRET=

# Used now: application base URL and exact comma-separated trusted origins.
# HTTP is accepted only for localhost/127.0.0.1/::1 outside production; production requires HTTPS.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Used now by the server-only Next.js proxy. The local default is http://127.0.0.1:8000.
BACKEND_API_URL=http://127.0.0.1:8000
# Optional: the current local API needs no key; future secured backends can require a bearer token.
BACKEND_API_KEY=

# Reserved for the later observability phase. No Sentry integration is installed now.
SENTRY_DSN=
